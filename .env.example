# Ayran-Network Environment Configuration

# Enable/disable Geo-IP country enrichment (1/0, true/false)
AYRAN_NETWORK_GEOIP_ENABLED=false

# Custom focus applications (+ to extend defaults, or comma-separated list to replace)
# AYRAN_NETWORK_FOCUS_APPS=+MyGame,AnotherGame,discord

# Network interface filter mode: "no-virtual", "exclude:docker,veth", or "include:eth0,wlan0"
# AYRAN_NETWORK_INTERFACE_FILTER=no-virtual

# Custom path to TOML configuration file
# AYRAN_NETWORK_CONFIG=~/.config/ayran-network/config.toml

# Custom export directory for metrics snapshots
# AYRAN_NETWORK_EXPORT_DIR=~/.ayran-network/exports

# Optional runtime overrides (CLI flags have highest precedence)
# AYRAN_NETWORK_POLL_INTERVAL=1.0
# AYRAN_NETWORK_HISTORY_SIZE=60
# AYRAN_NETWORK_GEOIP_ENDPOINT=https://ipwho.is/{encoded_ip}
