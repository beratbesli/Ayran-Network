# Runtime feature settings
BEER_NETWORK_GEOIP_ENABLED=true
# Prefix with + to extend the built-in game list; omit + to replace it.
# BEER_NETWORK_FOCUS_APPS=+MyGame,AnotherGame

# Optional Groq configuration
GROQ_API_KEY=
BEER_NETWORK_GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI-compatible local LLM configuration
# Plain HTTP endpoints are accepted only on the local loopback interface.
BEER_NETWORK_LLM_BASE_URL=
BEER_NETWORK_LLM_API_KEY=
BEER_NETWORK_LLM_MODEL=
